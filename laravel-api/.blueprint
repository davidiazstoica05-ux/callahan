created:
    - database/factories/PlatformFactory.php
    - database/factories/GenreFactory.php
    - database/factories/DirectorFactory.php
    - database/factories/MovieFactory.php
    - database/factories/InteractionFactory.php
    - database/factories/PreferenceFactory.php
    - database/factories/AlgorithmConfigFactory.php
    - database/migrations/2026_10_31_115041_create_platforms_table.php
    - database/migrations/2026_10_31_115042_create_genres_table.php
    - database/migrations/2026_10_31_115043_create_directors_table.php
    - database/migrations/2026_10_31_115044_create_movies_table.php
    - database/migrations/2026_10_31_115045_create_interactions_table.php
    - database/migrations/2026_10_31_115046_create_preferences_table.php
    - database/migrations/2026_10_31_115047_create_algorithm_configs_table.php
